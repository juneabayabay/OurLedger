# Our Ledger — public Supabase client config (safe for the browser)
# Copy to `.env.local` and fill in values from your Supabase project settings.
#
# Use the anon / publishable key ONLY.
# Never put the service_role key in NEXT_PUBLIC_* variables or commit it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred name in current Supabase docs (this is the public key):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Legacy alias (optional). If set, used when PUBLISHABLE_KEY is empty:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Do NOT add:
# SUPABASE_SERVICE_ROLE_KEY=...
